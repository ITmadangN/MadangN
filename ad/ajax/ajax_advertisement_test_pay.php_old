    while ($row = $db->fetch()) {

        $address = "";
        switch($ad_method) {
            
            case "recruit_platinum"     : $title = $row->title; $num = $row->community_recruit_listings_id; $address = $row->company_address; break;
            case "recruit_gold"         : $title = $row->title; $num = $row->community_recruit_listings_id; $address = $row->company_address;break;
            case "business_platinum"    : $title = $row->title; $num = $row->community_business_id; $address = $row->company_address; break;
            case "vehicle_dealer"       : $title = $row->contact_name; $num = $row->community_car_dealers_id; $address = $row->listing_address1; break;
            
        }
        
        $created_at = substr($row->created_at,0,10);
        
        $html .= "<tr>
                                                <td>
