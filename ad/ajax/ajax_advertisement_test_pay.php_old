        }

        // 자동차 딜러 광고
        if ($ad_method == "vehicle_dealer") {


            $dealer_website = $_POST['vd_dealer_website'];
            $listing_address1 = $_POST['vd_listing_address1'];
            $dealer_introduction = $_POST['vd_dealer_introduction'];
            
            $state_code = $_POST['vd_state_code'] ?? "";
            $city_name = $_POST['vd_city_name'] ?? "";


            $vd_logo_url = "";
            $vd_main_image_url = "";

            //if ($_FILES['vd_logo_url']['size'] > 0) $vd_logo_url = $_FILES['vd_logo_url']['name'];            
            //if ($_FILES['vd_main_image_url']['size'] > 0) $vd_main_image_url = $_FILES['vd_main_image_url']['name'];
            
            $vd_logo_url = make_file_name("vd_logo_url", $listing_id, "vd_logo_url_exist");
            $vd_main_image_url = make_file_name("vd_main_image_url", $listing_id, "vd_main_image_url_exist");
            
            // 불러오기 했으면 업데이트만 한다.
            if ($listing_id != "") {  
                
                $update_values = array(
                    'user_id' => $SS_ID,
                    'company_name' => $company_name,
                    'company_website' => $company_website,
                    'dealer_website' => $dealer_website,
                    'contact_name' => $contact_name,
                    'contact_email' => $contact_email,
                    'contact_phone' => $contact_phone,
                    'listing_address1' => $listing_address1,
                    'listing_address2' => "",
                    'state_code' => $state_code,
                    'city_name' => $city_name,
                    'listing_zip' => "",
                    'listing_zip_ext' => "",
                    'listing_country' => "",
                    'logo_url' => $vd_logo_url,
                    'main_image_url' => $vd_main_image_url,
                    'dealer_introduction' => $dealer_introduction,
                    'is_active' => 0,
                    'has_active_advertisement' => $has_active_advertisement,                    
                    'updated_user' => $SS_NICKNAME,
                    'updated_at' => date('Y-m-d H:i:s'),
                    'ip_address' => $_SERVER['REMOTE_ADDR'],
                );

                $result = $db->update('community_car_dealers', $update_values, 'community_car_dealers_id = ' . $listing_id);
                if ($result == false) throw new Exception("community_car_dealers update fail");
                unset($update_values);
                
                if ($_FILES['vd_logo_url']['size'] > 0) FILE_UPLOAD("user", "vehicle_dealer_files", "vehicle_dealer", $listing_id,  "vd_logo_url", "logo");
                if ($_FILES['vd_main_image_url']['size'] > 0)  FILE_UPLOAD("user", "vehicle_dealer_files", "vehicle_dealer", $listing_id,  "vd_main_image_url", "main");
                
                $community_car_dealers_id = $listing_id;
                
            }
            else {
                
                $insert_values = array(
                    'user_id' => $SS_ID,
                    'company_name' => $company_name,
                    'company_website' => $company_website,
                    'dealer_website' => $dealer_website,
                    'contact_name' => $contact_name,
                    'contact_email' => $contact_email,
                    'contact_phone' => $contact_phone,
                    'listing_address1' => $listing_address1,
                    'listing_address2' => "",
                    'state_code' => $state_code,
                    'city_name' => $city_name,
                    'listing_zip' => "",
                    'listing_zip_ext' => "",
                    'listing_country' => "",
                    'logo_url' => $vd_logo_url,
                    'main_image_url' => $vd_main_image_url,
                    'dealer_introduction' => $dealer_introduction,
                    'is_active' => 0,
                    'has_active_advertisement' => $has_active_advertisement,
                    'created_user' => $SS_NICKNAME,
                    'created_at' => date('Y-m-d H:i:s'),
                    'ip_address' => $_SERVER['REMOTE_ADDR'],
                );

                $result = $db->insert('community_car_dealers', $insert_values);
                if ($result == false) throw new Exception("community_car_dealers insert fail");
                $community_car_dealers_id = $db->getLastInsertId();
                
                //if ($vd_logo_url != "") FILE_UPLOAD("user", "vehicle_dealer_files", "vehicle_dealer", $community_car_dealers_id,  "vd_logo_url", "logo");
                //if ($vd_main_image_url != "") FILE_UPLOAD("user", "vehicle_dealer_files", "vehicle_dealer", $community_car_dealers_id,  "vd_main_image_url", "main");
                
                file_process($vd_logo_url, "vehicle_dealer_files","vehicle_dealer", $community_car_dealers_id, "vd_logo_url", "logo", $listing_id, "vd_logo_url_exist");
                file_process($vd_main_image_url, "vehicle_dealer_files","vehicle_dealer", $community_car_dealers_id, "vd_main_image_url", "main", $listing_id, "vd_main_image_url_exist");


                unset($insert_values);
            }



        }


        $section_type = 0;
        
        switch ($ad_method) {
            case "recruit_platinum":
                $section_type = 1;
                $listing_id = $community_recruit_listings_id;
                break;
            case "recruit_gold":
                $section_type = 2;
                $listing_id = $community_recruit_listings_id;
                break;
            case "business_platinum":
                $section_type = 3;
                $listing_id = $community_business_id;
                break;
            case "vehicle_dealer":
                $section_type = 4;
                $listing_id = $community_car_dealers_id;
                break;
            case "agent":
                $section_type = 5;
                break;
        }

        // 카드 결제 붙인다.
        /*

           https://www.authorize.net 활용

         */

        // 이벤트 기간
        $payment_amount = 0;
        $payment_method = "오픈기념 무료 서비스";    
        

        // 결제정보 등록
        $insert_values = array(
            'user_id' => $SS_ID,
            'section_type' => $section_type,
            'listing_id' => $listing_id,
            'desired_start_date' => $desired_start_date,
            'desired_end_date' => $desired_end_date,
            'start_date' =>  $desired_start_date,
            'end_date' =>  $desired_end_date,
            'validity_period' => $validity_period,
            'is_paid' => 'N',
            'payment_date' => date('Y-m-d H:i:s'),
            'payment_amount' => $payment_amount,
            'payment_method' => $payment_method,
            'is_active' => 0,
            'created_user' => $SS_NICKNAME,
            'created_at' => date('Y-m-d H:i:s'),
            'ip_address' => $_SERVER['REMOTE_ADDR'],
        );

        $result = $db->insert('ad_payments', $insert_values);
        if ($result == false) throw new Exception("ad_payments insert fail");
        $ad_payments_id = $db->getLastInsertId();
        unset($insert_values);

    }
    catch (Exception $e) {

        $db->transactionRollback();

        $result_data = [
            "status" => "fail",
            "msg" => $e->getMessage()

        ];

        echo json_encode($result_data, JSON_UNESCAPED_UNICODE);
        exit;
    }

//    $db->transactionRollback();
   $db->transactionCommit();

    $result_data = [
        "status" => "success",
        "msg" => "sucess",
        "num" => $ad_payments_id

    ];

    echo json_encode($result_data, JSON_UNESCAPED_UNICODE);
    exit;

}

if ($ac == "previous_advertising_list") {

    $ad_method = $_GET['ad_method'] ?? "";
    $company_name = $_GET['company_name'] ?? "";

    $html = "";

    $company_name = str_replace(' ', '', $company_name);
     
    $company_name = "%".$company_name."%";
    
    if ($ad_method == "recruit_platinum") {

        $row_sql = "SELECT A.*, C.validity_period, C.payment_amount, D.company_name, D.company_address FROM community_recruit_listings A 
                    left join community_recruit_listings_sub B on A.community_recruit_listings_id = B.community_recruit_listings_id    
                    left join ad_payments C on A.community_recruit_listings_id = C.listing_id
                    left join ad_company D on A.ad_company_id = D.ad_company_id
           where  REPLACE(D.company_name, ' ', '') like '{$company_name}' 
           and A.advertising_level = 'platinum' and ( C.section_type = 1 or C.section_type = 2)
           group by A.community_recruit_listings_id
           order by A.created_at desc";
           
        $advertiser_txt = "구인광고(Platinum)";
    }

    if ($ad_method == "recruit_gold") {

        $row_sql = "SELECT A.*, C.validity_period, C.payment_amount, D.company_name, D.company_address FROM community_recruit_listings A 
                    left join community_recruit_listings_sub B on A.community_recruit_listings_id = B.community_recruit_listings_id    
                    left join ad_payments C on A.community_recruit_listings_id = C.listing_id    
                    left join ad_company D on A.ad_company_id = D.ad_company_id
           where   REPLACE(D.company_name, ' ', '') like '{$company_name}' 
           and  A.advertising_level = 'gold' and  ( C.section_type = 1 or C.section_type = 2)
           group by A.community_recruit_listings_id                       
           order by A.created_at desc";
           
        $advertiser_txt = "구인광고(Gold)";   
    }

    if($ad_method == "business_platinum") {

        $row_sql = "SELECT A.*, C.validity_period, C.payment_amount, D.company_name, D.company_address FROM community_business A            
                    left join ad_payments C on A.community_business_id = C.listing_id    
                    left join ad_company D on A.ad_company_id = D.ad_company_id
           where   REPLACE(D.company_name, ' ', '') like '{$company_name}'
           and A.advertising_level = 'platinum' and   C.section_type = 3
           group by A.community_business_id      
           order by A.created_at desc";
        
        $advertiser_txt = "비지니스(Platinum)";   

    }


    if($ad_method == "vehicle_dealer") {
        
         $row_sql = "SELECT A.*, C.validity_period, C.payment_amount FROM community_car_dealers A            
                    left join ad_payments C on A.community_car_dealers_id = C.listing_id    
           where A.user_id = '{$SS_ID}'
                 and  C.section_type = 4
           order by A.created_at desc";
        
        $advertiser_txt = "자동차 딜러";   
    }
    
 //   $placeholders = ['company_name' => '%'.$company_name.'%'];
 
