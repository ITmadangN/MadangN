                                                </td>
                                                <td>
                                                    <input class=\"form-check-input rounded-0\" type=\"checkbox\" onclick=\"GET_INFO('{$ad_method}','{$num}');\">
                                                </td>
                                            </tr>";
    }

    $result_data = [
        "status" => "success",
        "msg" => "sucess",
        "items" => array("item" => $html)
    ];
    
    echo json_encode($result_data, JSON_UNESCAPED_UNICODE);
        exit;

