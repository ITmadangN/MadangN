 */
if($ac == "write_advertisement") {

    $result_data = [
        "status" => "success",
        "msg" => "sucess",
        "num" => 22

    ];

    echo json_encode($result_data, JSON_UNESCAPED_UNICODE);
    exit;
    
    $db->transactionBegin();

    try {

        $ad_method = $_POST['ad_method'];

        if($ad_method == "") {
            exit;
        }

        // 공통 입력
        $company_name = $_POST['company_name'] ?? "";
        $company_website = $_POST['company_website'] ?? "";
        $company_address = $_POST['company_address'] ?? "";
        $company_state_code = $_POST['company_state_code'] ?? "";
        $has_15_plus_employees = $_POST['has_15_plus_employees'] ?? "";

        $contact_name  = $_POST['contact_name'] ?? "";
        $contact_email = $_POST['contact_email'] ?? "";
        $contact_phone = $_POST['contact_phone'] ?? "";        
        
        $ad_company_id = $_POST['ad_company_id'] ?? "";        
        $listing_id = $_POST['listing_id'] ?? "";        
        
        $validity_period = 1;

        switch ($ad_method) {
            case "recruit_platinum":                
                $validity_period = $_POST['rp_validity_period'] ?? 1;
                break;
            case "recruit_gold":
                $validity_period = $_POST['rg_validity_period'] ?? 1;
                break;
            case "business_platinum":
                $validity_period = $_POST['bp_validity_period'] ?? 1;
                break;
            case "vehicle_dealer":
                $validity_period = $_POST['vd_validity_period'] ?? 1;
                break;
            case "agent":                
                break;
        }
        
        $desired_start_date = CONVERT_DATE_FORMAT($_POST['desired_start_date'] ?? ""); 
        $desired_end_date = ADD_MONTHS_TO_DATE($desired_start_date,$validity_period);
        
        $today = date("Ymd");
    
        if($desired_start_date <= $today && $today <= $desired_end_date) $has_active_advertisement = 1;
        else $has_active_advertisement = 0;

        if ($ad_method != "vehicle_dealer") {

            if ($listing_id != "") {      // 기존광고 등록한것이 있어서 광고기업 정보만 업데이트

